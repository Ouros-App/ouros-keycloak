# Bootstrap admin: configure only in the Discloud environment.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Keycloak is private and reachable only inside the Discloud VLAN.
KC_HOSTNAME=http://ouros-keycloak:8080

# Dedicated Keycloak PostgreSQL database on the Discloud VLAN.
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
KC_DB_USERNAME=keycloak

# Prefer KCRAW_DB_PASSWORD for injected secrets so literal '$' characters are
# preserved exactly. Do not define KC_DB_PASSWORD at the same time.
KCRAW_DB_PASSWORD=

# Do not commit production credentials.
