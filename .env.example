# Bootstrap admin: used only to create the first Keycloak administrator.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Permanent admin used by the startup IaC reconciler.
# During the first rollout the bootstrap credentials are accepted as a fallback,
# but configure these before deleting the temporary bootstrap administrator.
KC_IAC_ADMIN_USERNAME=
KC_IAC_ADMIN_PASSWORD=
KC_IAC_REALM=ouros

# Emergency recovery only. When both variables are set, startup creates a
# temporary master admin, restores the master realm admin role to the IaC
# administrator and removes the temporary account after a successful sync.
KC_RECOVERY_ADMIN_USERNAME=
KC_RECOVERY_ADMIN_PASSWORD=

# Public Keycloak URL exposed by Discloud.
KC_HOSTNAME=https://ouros-keycloak.discloud.app

# Dedicated Keycloak PostgreSQL database on the Discloud VLAN.
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
KC_DB_USERNAME=keycloak

# Prefer KCRAW_DB_PASSWORD for injected secrets so literal '$' characters are
# preserved exactly. Do not define KC_DB_PASSWORD at the same time.
KCRAW_DB_PASSWORD=

# Optional realm SMTP configuration. Leave OUROS_SMTP_HOST empty to keep SMTP
# untouched. For local Mailpit set OUROS_SMTP_HOST=host.docker.internal when
# Keycloak runs in Docker on the host, or OUROS_SMTP_HOST=mailpit on a shared
# Docker network. In both cases set OUROS_SMTP_PORT=1025 and
# OUROS_SMTP_STARTTLS=false.
OUROS_SMTP_HOST=
OUROS_SMTP_PORT=587
OUROS_SMTP_FROM=no-reply@ouros.local
OUROS_SMTP_FROM_DISPLAY_NAME=Ouros
OUROS_SMTP_AUTH=false
OUROS_SMTP_STARTTLS=true
OUROS_SMTP_SSL=false
OUROS_SMTP_USER=
OUROS_SMTP_PASSWORD=

# Do not commit production credentials.
