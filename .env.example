# Bootstrap admin: used only to create the first Keycloak administrator.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Permanent admin used by the startup IaC reconciler.
# During the first rollout the bootstrap credentials are accepted as a fallback,
# but configure these before deleting the temporary bootstrap administrator.
KC_IAC_ADMIN_USERNAME=
KC_IAC_ADMIN_PASSWORD=
KC_IAC_REALM=ouros

# Public Keycloak URL exposed by Discloud.
KC_HOSTNAME=https://ouros-keycloak.discloud.app

# Dedicated Keycloak PostgreSQL database on the Discloud VLAN.
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
KC_DB_USERNAME=keycloak

# Prefer KCRAW_DB_PASSWORD for injected secrets so literal '$' characters are
# preserved exactly. Do not define KC_DB_PASSWORD at the same time.
KCRAW_DB_PASSWORD=

# Do not commit production credentials.
